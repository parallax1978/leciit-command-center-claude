<div class="border-b border-line bg-canvas-sunken/60">
  <div class="mx-auto w-full max-w-page px-4 pb-8 pt-6 sm:px-6 sm:pb-10 sm:pt-8 lg:px-8">
    {{> breadcrumbs breadcrumbs=page.breadcrumbs}}
    <div class="mt-6 max-w-3xl">
      <p class="eyebrow">Archive</p>
      <h1 class="mt-2 text-[2.375rem] font-semibold leading-[1.08] tracking-[-0.025em] text-ink sm:text-[2.75rem] lg:text-[3rem]">Posts from {{archive.year}}</h1>
      <p class="mt-4 text-lg text-ink-soft">{{archive.count}} posts, newest first. Every post is listed, so nothing is more than two clicks away.</p>
    </div>
    <nav aria-label="Years" class="mt-6">
      <ul class="flex flex-wrap gap-2">
        {{#each archive.years}}
        <li><a href="{{url}}" class="inline-flex min-h-[44px] items-center rounded-full border px-4 text-[14px] font-semibold btn-focus {{#if active}}border-brand-purple bg-brand-tint text-brand-purple{{else}}border-line-strong bg-canvas text-ink-soft hover:border-ink-muted hover:text-ink{{/if}}"{{#if active}} aria-current="page"{{/if}}>{{year}}<span class="ml-1.5 text-[12px] font-medium {{#if active}}text-brand-purple{{else}}text-ink-muted{{/if}}">{{count}}</span></a></li>
        {{/each}}
      </ul>
    </nav>
  </div>
</div>

<div class="mx-auto w-full max-w-page px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
  <div class="grid gap-10 lg:grid-cols-[14rem_minmax(0,1fr)]">
    <nav aria-label="Months" class="lg:sticky lg:top-6 lg:self-start">
      <p class="text-[13px] font-semibold uppercase tracking-[0.08em] text-ink-muted">Jump to month</p>
      <ul class="mt-3 flex flex-wrap gap-2 lg:flex-col lg:gap-1">
        {{#each archive.months}}
        <li><a href="#{{id}}" class="inline-flex min-h-[44px] items-center rounded-md text-[15px] text-ink-soft underline-offset-4 hover:text-ink hover:underline btn-focus lg:px-1">{{name}} <span class="ml-1 text-sm text-ink-muted">({{count}})</span></a></li>
        {{/each}}
      </ul>
    </nav>
    <div class="min-w-0">
      {{#each archive.months}}
      <section id="{{id}}" aria-labelledby="{{id}}-heading" class="scroll-mt-6 border-t border-line py-6 first:border-t-0 first:pt-0">
        <h2 id="{{id}}-heading" class="text-xl font-semibold text-ink">{{name}}</h2>
        <ul class="mt-4 divide-y divide-line">
          {{#each posts}}
          <li class="flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:gap-4">
            <time datetime="{{publishedISO}}" class="shrink-0 text-sm tabular-nums text-ink-muted sm:w-16">{{publishedShort}}</time>
            <a href="{{url}}" class="link-inline rounded-sm text-[16px] font-medium text-ink underline-offset-4 hover:text-brand-purple hover:underline btn-focus">{{title}}</a>
            <a href="{{category.url}}" class="link-inline rounded-sm text-sm text-ink-muted underline-offset-4 hover:underline btn-focus sm:ml-auto sm:shrink-0">{{category.name}}</a>
          </li>
          {{/each}}
        </ul>
      </section>
      {{/each}}
    </div>
  </div>
</div>
