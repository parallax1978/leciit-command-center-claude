{{!-- One year of posts, grouped by month. The years are a segmented control; the months are the page's "On this page" list. --}}
<div class="wrap">
  <div class="doc doc--rail">
    <aside class="sidebar" aria-label="Blog topics">{{> sidebar mode="desktop"}}</aside>
    <div class="content">
      {{> browse}}
      {{> breadcrumbs breadcrumbs=page.breadcrumbs}}
      <h1>Posts from {{archive.year}}</h1>
      <p class="lead-xl">{{archive.count}} posts, newest first. Every post is listed, so nothing is more than two clicks away.</p>
      <nav aria-label="Years">
        <ul class="seg">
          {{#each archive.years}}
          <li><a href="{{url}}" class="seg-item btn-focus"{{#if active}} aria-current="page"{{/if}}>{{year}}<span class="seg-count">{{count}}</span></a></li>
          {{/each}}
        </ul>
      </nav>

      <details class="toc-mobile m-only">
        <summary class="btn-focus">Jump to a month</summary>
        {{> toc toc=archive.months}}
      </details>

      {{#each archive.months}}
      <section id="{{id}}" aria-labelledby="{{id}}-heading" class="arch-month">
        <h2 id="{{id}}-heading" class="arch-h">{{text}}<span class="arch-count">{{count}} posts</span></h2>
        <ul class="post-list">
          {{#each posts}}
          {{> post-row}}
          {{/each}}
        </ul>
      </section>
      {{/each}}
    </div>

    <aside class="rail" aria-label="Months and next step">
      <p class="rail-label">Year</p>
      <p class="rail-value">{{archive.year}}</p>
      {{> toc toc=archive.months}}
      {{> cta-rail cta=archive.cta}}
    </aside>
  </div>
</div>

{{> cta-band band=archive.band}}
