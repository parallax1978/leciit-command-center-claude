<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{page.title}}</title>
    <meta name="description" content="{{page.description}}" />
    {{#if page.robots}}<meta name="robots" content="{{page.robots}}" />{{/if}}
    <link rel="canonical" href="{{page.canonical}}" />
    {{#if page.prevUrl}}<link rel="prev" href="{{page.prevUrl}}" />{{/if}}
    {{#if page.nextUrl}}<link rel="next" href="{{page.nextUrl}}" />{{/if}}
    <meta property="og:site_name" content="Legiit" />
    <meta property="og:type" content="{{page.ogType}}" />
    <meta property="og:title" content="{{page.title}}" />
    <meta property="og:description" content="{{page.description}}" />
    <meta property="og:url" content="{{page.canonical}}" />
    {{#if page.ogImage}}<meta property="og:image" content="{{page.ogImage}}" />{{/if}}
    <meta name="twitter:card" content="{{#if page.ogImage}}summary_large_image{{else}}summary{{/if}}" />
    {{#if page.publishedISO}}<meta property="article:published_time" content="{{page.publishedISO}}" />{{/if}}
    {{#if page.modifiedISO}}<meta property="article:modified_time" content="{{page.modifiedISO}}" />{{/if}}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    {{#each page.jsonld}}
    <script type="application/ld+json">{{{json this}}}</script>
    {{/each}}
    {{!-- Preview build only: Vite compiles this into the hashed blog CSS and JS files. In the CMS, link the built files from dist-blog/assets instead. --}}
    <script type="module" src="../src/blog/main.ts"></script>
  </head>
  <body class="bg-canvas">
    {{> art-defs}}
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-canvas focus:px-4 focus:py-3 focus:text-ink btn-focus">Skip to content</a>
    {{> header}}
    <main id="main">
      {{{body}}}
    </main>
    {{> footer}}
  </body>
</html>
