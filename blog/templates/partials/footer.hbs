{{!-- Quiet grey footer in the Apple manner: the goal hubs, the blog's own pages and Legiit's main links. --}}
<footer class="foot">
  <div class="lib">
    <div class="foot-grid">
      <div class="foot-brand">
        <img src="{{site.logo}}" alt="Legiit" width="48" height="22" class="h-[22px] w-auto" loading="lazy" decoding="async" />
        <p class="mt-3 max-w-xs">{{stats.posts}} guides on SEO, marketing, freelancing and running a business, from the Legiit marketplace.</p>
      </div>
      <nav aria-label="Goal hubs" class="foot-col">
        <p class="foot-h">Browse By Goal</p>
        <ul>
          {{#each nav.hubs}}
          <li><a href="{{@root.url.index}}#hub-{{id}}" class="foot-link btn-focus">{{name}}</a></li>
          {{/each}}
        </ul>
      </nav>
      <nav aria-label="Blog" class="foot-col">
        <p class="foot-h">Blog</p>
        <ul>
          <li><a href="{{url.latest}}" class="foot-link btn-focus">Latest posts</a></li>
          <li><a href="{{url.guides}}" class="foot-link btn-focus">Buyer’s guides</a></li>
          <li><a href="{{url.topics}}" class="foot-link btn-focus">All topics</a></li>
          <li><a href="{{url.archive}}" class="foot-link btn-focus">Archive by year</a></li>
          <li><a href="{{url.search}}" class="foot-link btn-focus">Search</a></li>
        </ul>
      </nav>
      <nav aria-label="Legiit" class="foot-col">
        <p class="foot-h">Legiit</p>
        <ul>
          <li><a href="{{site.marketplaceUrl}}" class="foot-link btn-focus">Marketplace</a></li>
          <li><a href="{{site.pricingUrl}}" class="foot-link btn-focus">Command Center pricing</a></li>
          <li><a href="{{site.coursesUrl}}" class="foot-link btn-focus">Courses</a></li>
          <li><a href="{{site.supportUrl}}" class="foot-link btn-focus">Support</a></li>
        </ul>
      </nav>
    </div>
    <div class="foot-legal">
      <p>Legiit Blog</p>
      <nav aria-label="Legal">
        <ul class="flex items-center gap-x-4">
          <li><a href="{{site.privacyUrl}}" class="foot-link btn-focus">Privacy</a></li>
          <li><a href="{{site.termsUrl}}" class="foot-link btn-focus">Terms</a></li>
        </ul>
      </nav>
    </div>
  </div>
</footer>
