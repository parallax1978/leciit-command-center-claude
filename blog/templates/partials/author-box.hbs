{{!-- Who wrote the post, with a link to their profile and their other posts. The bio field is shown only when the CMS supplies one. --}}
<section aria-labelledby="author-heading" class="author-box">
  <h2 id="author-heading" class="author-box-label">About the author</h2>
  <div class="mt-4 flex items-start gap-4">
    {{#if author.avatar}}
    <img src="{{author.avatar}}" alt="" width="56" height="56" loading="lazy" decoding="async" class="h-14 w-14 shrink-0 rounded-full object-cover" />
    {{else}}
    <span aria-hidden="true" class="author-initial">{{author.initial}}</span>
    {{/if}}
    <div class="min-w-0">
      <p class="text-[17px] font-semibold text-ink">{{author.name}}</p>
      {{#if author.role}}<p class="text-[15px] text-ink-muted">{{author.role}}</p>{{/if}}
      {{#if author.bio}}<p class="mt-2 max-w-prose text-[15px] leading-relaxed text-ink-soft">{{author.bio}}</p>{{/if}}
      <div class="mt-1 flex flex-wrap gap-x-5 text-[15px]">
        {{#if author.pageUrl}}<a href="{{author.pageUrl}}" class="text-link btn-focus">More posts by {{author.name}}</a>{{/if}}
        {{#if author.url}}<a href="{{author.url}}" class="text-link text-link--quiet btn-focus">Legiit profile</a>{{/if}}
      </div>
    </div>
  </div>
</section>
