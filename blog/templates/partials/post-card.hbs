{{!-- One post as an image-and-caption item (the buyer's guide rows and topic rows). The real featured image, 16:9, 12px radius. --}}
<a href="{{url}}" class="btn-focus">
  <span class="vgrid-media">{{> post-image post=this}}</span>
  <span class="vgrid-cap">{{title}}</span>
  <span class="vgrid-sub">{{category.name}}<span aria-hidden="true"> · </span><time datetime="{{publishedISO}}">{{publishedText}}</time></span>
</a>
