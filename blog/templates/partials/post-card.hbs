{{!-- One post as a tile, like Apple's section tiles: artwork, then the title under it, no border. The whole card is one link, so readers and screen readers meet it once. --}}
<article class="card">
  <a href="{{url}}" class="card-link btn-focus">
    {{> art art=art size="card"}}
    <div class="card-text">
      <h3 class="card-title">{{title}}</h3>
      <p class="card-meta">{{category.name}}<span aria-hidden="true"> · </span><time datetime="{{publishedISO}}">{{publishedShort}}</time></p>
    </div>
  </a>
</article>
