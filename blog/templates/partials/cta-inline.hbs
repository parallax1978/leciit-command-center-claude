{{!-- The topic's offer as one slim callout in the article's own type, placed right after the intro. Paragraphs only, so the outline is unchanged. --}}
<aside aria-label="{{cta.eyebrow}}" class="cta-inline" data-cta-placement="{{placement}}">
  <p class="cta-inline-text"><strong class="cta-inline-label">{{cta.eyebrow}}.</strong> {{cta.title}}.</p>
  <a href="{{cta.url}}" class="cta-inline-link btn-focus" data-cta="{{placement}}-primary">{{cta.ctaLabel}}<svg aria-hidden="true" focusable="false" class="ico"><use href="#i-arrow" /></svg></a>
</aside>
