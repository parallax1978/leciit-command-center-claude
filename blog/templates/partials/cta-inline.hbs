{{!-- The topic's offer as an off-white box in the article's own type: right after the intro, and again at the end. Paragraphs only, so the outline is unchanged. --}}
<aside aria-label="{{cta.eyebrow}}" class="cta-inline" data-cta-placement="{{placement}}">
  <p class="eyebrow">{{cta.eyebrow}}</p>
  <p><strong>{{cta.title}}.</strong> {{cta.body}}</p>
  <a href="{{cta.url}}" class="btn-main btn-focus" data-cta="{{placement}}-primary">{{cta.ctaLabel}}</a>
</aside>
