{{!-- Visible breadcrumb for phones and tablets, where the sidebar is folded away. The last item is the current page as plain text. The matching BreadcrumbList JSON-LD is in the head. --}}
<nav aria-label="Breadcrumb" class="crumbs m-only">
  <ol class="crumbs-list">
    {{#each breadcrumbs}}
    <li class="crumbs-item">
      {{#if @index}}<svg aria-hidden="true" focusable="false" class="crumbs-sep ico"><use href="#i-chev-right" /></svg>{{/if}}
      {{#if url}}
      <a href="{{url}}" class="crumbs-link btn-focus">{{name}}</a>
      {{else}}
      <span aria-current="page" class="crumbs-current">{{name}}</span>
      {{/if}}
    </li>
    {{/each}}
  </ol>
</nav>
