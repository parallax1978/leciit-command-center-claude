{{!-- The newest post, large, at the top of the index. Its image is the page's largest element, so it is not lazy-loaded. --}}
<article class="group grid overflow-hidden rounded-2xl border border-line bg-canvas md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
  <a href="{{url}}" tabindex="-1" aria-hidden="true" class="block bg-canvas-sunken">
    {{#if image}}
    <img src="{{image.src}}" alt="" width="{{image.width}}" height="{{image.height}}" fetchpriority="high" decoding="async" class="featured-image aspect-[1200/630] h-full w-full object-cover" />
    {{else}}
    <div class="aspect-[1200/630] h-full w-full" style="background-image: linear-gradient(115deg, #6A13CF 0%, #C71E92 100%)"></div>
    {{/if}}
  </a>
  <div class="flex flex-col justify-center p-6 sm:p-8">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[13px]">
      <span class="rounded-full bg-brand-tint px-3 py-1 font-semibold text-brand-purple">Latest</span>
      <a href="{{category.url}}" class="link-inline rounded-sm font-semibold text-brand-purple underline-offset-4 hover:underline btn-focus">{{category.name}}</a>
      <span aria-hidden="true" class="text-line-strong">·</span>
      <span class="font-medium text-ink-muted">{{readingMinutes}} min read</span>
    </div>
    <h2 class="mt-3 text-[1.5rem] font-semibold leading-[1.15] tracking-[-0.02em] sm:text-[1.75rem] lg:text-[2rem]">
      <a href="{{url}}" class="rounded-sm text-ink hover:text-brand-purple btn-focus">{{title}}</a>
    </h2>
    <p class="mt-3 text-[16px] leading-relaxed text-ink-soft">{{excerpt}}</p>
    <p class="mt-4 text-sm text-ink-muted">
      {{#if author.pageUrl}}<a href="{{author.pageUrl}}" class="link-inline rounded-sm font-medium text-ink-soft underline-offset-4 hover:underline btn-focus">{{author.name}}</a>{{else}}<span class="font-medium text-ink-soft">{{author.name}}</span>{{/if}}
      <span aria-hidden="true"> · </span>
      <time datetime="{{publishedISO}}">{{publishedText}}</time>
    </p>
  </div>
</article>
