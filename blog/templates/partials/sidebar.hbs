{{!-- Apple's navigator: a Filter box, then two levels (goal hub > topic). Every item has a Lucide-style icon; the current item is
     bold with a purple icon, its open parent group bold with a black icon. Rendered twice per page (desktop sidebar, phone
     "Browse topics" disclosure), so pass mode="desktop" or mode="phone". Without JavaScript the filter box is a search form. --}}
<div class="side" data-side>
  <form action="{{url.search}}" method="get" role="search" class="side-filter">
    <label for="side-filter-{{mode}}" class="sr-only">Filter topics, or press Enter to search every post</label>
    <svg class="ico" aria-hidden="true" focusable="false"><use href="#i-filter" /></svg>
    <input id="side-filter-{{mode}}" type="search" name="{{site.searchParam}}" placeholder="Filter" autocomplete="off" enterkeyhint="search" data-filter-input />
  </form>
  <nav aria-label="Topics">
    <ul class="tree">
      {{#each nav.hubs}}
      <li data-hub>
        <details{{#if open}} open{{/if}}>
          <summary class="btn-focus"><svg class="ico" aria-hidden="true" focusable="false"><use href="#i-{{icon}}" /></svg><span>{{name}}</span></summary>
          <ul>
            {{#each topics}}
            <li data-topic>
              <a href="{{url}}" class="btn-focus"{{#if active}} aria-current="page"{{/if}}>
                <svg class="ico" aria-hidden="true" focusable="false"><use href="#i-{{icon}}" /></svg>
                <span class="side-name">{{name}}</span>
                <span class="side-count">{{count}}</span>
              </a>
            </li>
            {{/each}}
          </ul>
        </details>
      </li>
      {{/each}}
    </ul>
    <p class="side-empty" hidden data-filter-empty>No topic matches. Press Enter to search every post.</p>
  </nav>
</div>
