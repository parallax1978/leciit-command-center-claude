{{!-- The same offer again at the end of the post, with the topic's tile and both actions. Paragraphs only, so it never changes the article's outline. --}}
<aside aria-label="{{cta.eyebrow}}" class="cta-box" data-cta-placement="{{placement}}">
  {{#if art}}<div class="cta-box-art">{{> art art=art size="mini"}}</div>{{/if}}
  <div class="min-w-0">
    <p class="eyebrow">{{cta.eyebrow}}</p>
    <p class="cta-box-title">{{cta.title}}</p>
    <p class="cta-box-body">{{cta.body}}</p>
    <div class="cta-box-actions">
      <a href="{{cta.url}}" class="btn-brand btn-main btn-focus" data-cta="{{placement}}-primary">{{cta.ctaLabel}}<svg aria-hidden="true" focusable="false" class="ico"><use href="#i-arrow" /></svg></a>
      {{#if cta.secondaryLabel}}
      <a href="{{cta.secondaryUrl}}" class="btn-quiet btn-focus" data-cta="{{placement}}-secondary">{{cta.secondaryLabel}}</a>
      {{/if}}
    </div>
  </div>
</aside>
