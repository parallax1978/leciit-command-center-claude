{{!-- A contextual call to action matched to the post's topic. It uses paragraphs, not headings, so it never changes the article's outline. --}}
<aside aria-label="{{cta.eyebrow}}" class="cta-box not-prose my-10 rounded-2xl border border-brand-purple/20 bg-brand-tint px-6 py-6 sm:px-8 sm:py-7" data-cta-placement="{{placement}}">
  <p class="eyebrow">{{cta.eyebrow}}</p>
  <p class="mt-2 text-[1.25rem] font-semibold leading-snug tracking-[-0.01em] text-ink sm:text-[1.375rem]">{{cta.title}}</p>
  <p class="mt-2 max-w-prose text-[15px] leading-relaxed text-ink-soft">{{cta.body}}</p>
  <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center">
    <a href="{{cta.url}}" class="btn-brand inline-flex min-h-[48px] items-center justify-center gap-3 whitespace-nowrap rounded-lg border border-transparent px-5 text-base font-semibold leading-none btn-focus" data-cta="{{placement}}-primary">{{cta.ctaLabel}}<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></a>
    {{#if cta.secondaryLabel}}
    <a href="{{cta.secondaryUrl}}" class="inline-flex min-h-[48px] items-center justify-center rounded-lg border border-brand-purple bg-canvas px-5 text-base font-semibold leading-none text-brand-purple hover:bg-canvas-sunken btn-focus" data-cta="{{placement}}-secondary">{{cta.secondaryLabel}}</a>
    {{/if}}
  </div>
</aside>
