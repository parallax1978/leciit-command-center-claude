{{!-- One post as a list row: icon, title, date. Used by the "All posts" lists on topic, author and search pages. --}}
<li><a href="{{url}}" class="btn-focus"><svg class="ico" aria-hidden="true" focusable="false"><use href="#i-news" /></svg><span>{{title}}</span><span class="when"><time datetime="{{publishedISO}}">{{publishedText}}</time></span></a></li>
