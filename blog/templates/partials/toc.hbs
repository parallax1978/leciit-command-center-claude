{{!-- "On this page": built from the post's H2s by the CMS at render time (or from a page's own sections). Real anchors, so it works without JavaScript; main.ts marks the section in view. Pass topLink=true to start the list with a link back to the top of the post. --}}
<nav aria-label="On this page" class="toc">
  <p class="toc-label">On this page</p>
  <ol class="toc-list">
    {{#if topLink}}<li><a href="#post-top" class="toc-link link-inline btn-focus">Introduction</a></li>{{/if}}
    {{#each toc}}
    <li><a href="#{{id}}" class="toc-link link-inline btn-focus">{{text}}</a></li>
    {{/each}}
  </ol>
</nav>
