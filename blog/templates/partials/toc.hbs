{{!-- "On this page": H2s with their H3s nested, built by the CMS at render time from the post's headings. Real anchors, so it works without JavaScript; main.ts marks the section in view. Pass top="..." to start the list with a link to the top of the post. --}}
<nav aria-label="On this page" class="toc">
  <p class="toc-label">On this page</p>
  <ol class="toc-list">
    {{#if top}}<li><a href="#main" class="toc-link link-inline btn-focus" aria-current="location">{{top}}</a></li>{{/if}}
    {{#each toc}}
    <li>
      <a href="#{{id}}" class="toc-link link-inline btn-focus">{{text}}</a>
      {{#if children.length}}
      <ol class="toc-list">
        {{#each children}}
        <li><a href="#{{id}}" class="toc-link link-inline btn-focus">{{text}}</a></li>
        {{/each}}
      </ol>
      {{/if}}
    </li>
    {{/each}}
    {{#if tail}}<li><a href="#{{tail.id}}" class="toc-link link-inline btn-focus">{{tail.text}}</a></li>{{/if}}
  </ol>
</nav>
