{{!-- Closing panel on every page, like Apple's "New to design?" pathway, on the brand navy. --}}
<section class="section section--alt" aria-labelledby="pathway-heading">
  <div class="wrap">
    <div class="pathway">
      <div class="pathway-glyph"><svg class="ico" aria-hidden="true" focusable="false"><use href="#i-rocket" /></svg></div>
      <h2 id="pathway-heading">{{band.title}}</h2>
      <p>{{band.body}}</p>
      <div class="pathway-actions">
        <a href="{{band.primaryUrl}}" class="btn-main btn-focus" data-cta="band-primary">{{band.primaryLabel}}</a>
        <a href="{{band.secondaryUrl}}" class="btn-quiet btn-focus" data-cta="band-secondary">{{band.secondaryLabel}}</a>
      </div>
    </div>
  </div>
</section>
