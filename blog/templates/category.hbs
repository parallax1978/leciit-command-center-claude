{{!-- A topic page in the layout of Apple's Human Interface Guidelines hub: the navigator on the left; title, intro, then
     sections of image tiles (fundamentals, buyer's guides, new and updated), the full post list, and topic cards. --}}
<div class="wrap">
  <div class="doc">
    <aside class="sidebar" aria-label="Blog topics">{{> sidebar mode="desktop"}}</aside>
    <div class="content">
      {{> browse}}
      {{> breadcrumbs breadcrumbs=page.breadcrumbs}}
      <h1>{{category.name}}{{#unless category.isFirst}}, page {{category.pageNumber}}{{/unless}}</h1>
      <p class="lead-xl">{{category.description}}</p>

      {{#if category.isFirst}}
      {{#if category.fundamentals.length}}
      <section aria-labelledby="c1">
        <h2 id="c1" class="h2-lib">Start with the fundamentals</h2>
        <p>{{category.fundamentalsBlurb}}</p>
        <a class="h2-more chev btn-focus" href="#all-posts">View all</a>
        <div class="topic-tiles">
          {{#each category.fundamentals}}
          <a href="{{url}}" class="btn-focus"><span class="tile-media">{{> post-image post=this}}</span><span>{{title}}</span></a>
          {{/each}}
        </div>
      </section>
      {{/if}}

      {{#if category.guides.length}}
      <section id="buyers-guides" aria-labelledby="c2">
        <h2 id="c2" class="h2-lib">Compare before you hire</h2>
        <p>{{#if category.isGuides}}Shortlists of agencies, services and tools across every topic, with prices and who each suits.{{else}}Shortlists of {{category.name}} agencies, services and tools, with prices and who each suits.{{/if}}</p>
        <a class="h2-more chev btn-focus" href="{{url.guides}}">View all</a>
        <div class="topic-tiles">
          {{#each category.guides}}
          <a href="{{url}}" class="btn-focus"><span class="tile-media">{{> post-image post=this}}</span><span>{{title}}</span></a>
          {{/each}}
        </div>
      </section>
      {{/if}}

      {{#if category.recent.length}}
      <section aria-labelledby="c3">
        <h2 id="c3" class="h2-lib">New and updated</h2>
        <p>The newest {{category.name}} guides, newest first.</p>
        <a class="h2-more chev btn-focus" href="#all-posts">View all</a>
        <div class="topic-tiles">
          {{#each category.recent}}
          <a href="{{url}}" class="btn-focus"><span class="tile-media">{{> post-image post=this}}</span><span>{{title}}</span><span class="vgrid-sub"><time datetime="{{publishedISO}}">{{publishedText}}</time></span></a>
          {{/each}}
        </div>
      </section>
      {{/if}}
      {{/if}}

      <section id="all-posts" aria-labelledby="c6">
        <h2 id="c6" class="h2-lib">{{#if category.isFirst}}{{#if category.isGuides}}All buyer’s guides{{else}}All {{category.name}} posts{{/if}}{{else}}Page {{category.pageNumber}} of {{category.totalPages}}{{/if}}</h2>
        <p>{{category.count}} posts, newest first.</p>
        <ul class="post-list">
          {{#each category.posts}}
          {{> post-row}}
          {{/each}}
        </ul>
        {{> pagination pagination=category.pagination}}
      </section>

      {{#if category.related.length}}
      <section id="related-topics" aria-labelledby="c4">
        <h2 id="c4" class="h2-lib">More in {{category.hub.name}}</h2>
        <div class="topic-cards">
          {{#each category.related}}
          <div>
            <a href="{{url}}" class="btn-focus"><span class="tile-media">{{> post-image post=post}}</span></a>
            <h3>{{name}}</h3>
            <p>{{count}} {{about}}.</p>
            <a class="text-link chev btn-focus" href="{{url}}">View all</a>
          </div>
          {{/each}}
        </div>
      </section>
      {{/if}}

      <section aria-labelledby="c5">
        {{> cta-inline cta=category.cta placement="category"}}
      </section>
    </div>
  </div>
</div>

{{> cta-band band=category.band}}
