{{!-- An author's posts. Photo and bio show when the CMS supplies them. --}}
<div class="wrap">
  <div class="doc">
    <aside class="sidebar" aria-label="Blog topics">{{> sidebar mode="desktop"}}</aside>
    <div class="content">
      {{> browse}}
      {{> breadcrumbs breadcrumbs=page.breadcrumbs}}
      <header class="author-head">
        {{#if author.avatar}}
        <img src="{{author.avatar}}" alt="" width="88" height="88" decoding="async" class="author-initial" style="object-fit:cover" />
        {{else}}
        <span aria-hidden="true" class="author-initial">{{author.initial}}</span>
        {{/if}}
        <div class="min-w-0">
          <p class="eyebrow">Author</p>
          <h1>{{author.name}}{{#unless author.isFirst}}, page {{author.pageNumber}}{{/unless}}</h1>
          <p class="lead-xl">{{author.count}} posts on the Legiit blog, newest first.</p>
          {{#if author.bio}}<p class="mt-3">{{author.bio}}</p>{{/if}}
          {{#if author.url}}<p><a href="{{author.url}}" class="text-link chev btn-focus">Legiit profile</a></p>{{/if}}
        </div>
      </header>

      <section aria-labelledby="author-posts-heading">
        <h2 id="author-posts-heading" class="h2-lib">{{#if author.isFirst}}Posts by {{author.name}}{{else}}Page {{author.pageNumber}} of {{author.totalPages}}{{/if}}</h2>
        <ul class="post-list">
          {{#each author.posts}}
          {{> post-row}}
          {{/each}}
        </ul>
        {{> pagination pagination=author.pagination}}
      </section>
    </div>
  </div>
</div>

{{> cta-band band=author.band}}
