<div class="border-b border-line bg-canvas-sunken/60">
  <div class="mx-auto w-full max-w-page px-4 pb-8 pt-6 sm:px-6 sm:pb-10 sm:pt-8 lg:px-8">
    {{> breadcrumbs breadcrumbs=page.breadcrumbs}}
    <div class="mt-6 flex items-start gap-5">
      {{#if author.avatar}}
      <img src="{{author.avatar}}" alt="" width="80" height="80" decoding="async" class="h-20 w-20 shrink-0 rounded-full object-cover" />
      {{else}}
      <span aria-hidden="true" class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-brand-tint text-2xl font-semibold text-brand-purple">{{author.initial}}</span>
      {{/if}}
      <div class="min-w-0">
        <p class="eyebrow">Author</p>
        <h1 class="mt-1 text-[2rem] font-semibold leading-[1.1] tracking-[-0.025em] text-ink sm:text-[2.5rem]">{{author.name}}</h1>
        {{#if author.role}}<p class="mt-2 text-lg text-ink-soft">{{author.role}}</p>{{/if}}
        {{#if author.bio}}<p class="mt-2 max-w-2xl text-[16px] leading-relaxed text-ink-soft">{{author.bio}}</p>{{/if}}
        <p class="mt-3 text-sm text-ink-muted">{{author.count}} posts{{#if author.url}} · <a href="{{author.url}}" class="rounded-sm font-medium text-brand-purple underline-offset-4 hover:underline btn-focus">Legiit profile</a>{{/if}}</p>
      </div>
    </div>
  </div>
</div>

<div class="mx-auto w-full max-w-page px-4 sm:px-6 lg:px-8">
  <section aria-labelledby="author-posts-heading" class="py-12 sm:py-16">
    <h2 id="author-posts-heading" class="sr-only">Posts by {{author.name}}</h2>
    <div class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {{#each author.posts}}
      {{> post-card}}
      {{/each}}
    </div>
    {{> pagination pagination=author.pagination}}
  </section>
</div>

{{> cta-band band=author.band}}
